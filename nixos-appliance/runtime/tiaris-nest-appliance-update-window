#!/usr/bin/env python3
"""Only a root-verified signed policy can authorize an update. The Nest
installs it when it is idle, and in the policy's night period at the latest;
"Update now" skips the wait for one attempt. There are no modes: a policy that
still names `window` (signed before 19 November 2026) is read the same way.
Exit 0 allows it; exit 75 prints what it waits for. Either way the last line
says why, in plain words, for the journal."""
import datetime
import json
from pathlib import Path
import subprocess
import sys
from zoneinfo import ZoneInfo
from appliance_state import CONTROL, INBOX, UID, load, run

# The daemon serves every boot, install and cache request and writes this.
ACTIVITY = Path('/run/tiaris-nest/activity.json')
QUIET_SECONDS = 10 * 60
# A report older than this means the daemon serves nothing at all.
STALE_SECONDS = 3 * 60
# Without a report, give a freshly started Nest time to start its daemon.
UNREPORTED_UPTIME_SECONDS = 30 * 60


def in_window(schedule, now):
    local = now.astimezone(ZoneInfo(schedule['timezone']))
    current_minute = ((local.weekday() + 1) % 7) * 1440 + local.hour * 60 + local.minute
    hour, minute = map(int, schedule['start'].split(':'))
    return any((current_minute - day * 1440 - hour * 60 - minute) % 10080 < schedule['duration_minutes'] for day in schedule['weekdays'])


def uptime_seconds():
    return float(Path('/proc/uptime').read_text().split()[0])


def timestamp(value):
    parsed = datetime.datetime.strptime(value, '%Y-%m-%dT%H:%M:%SZ')
    return parsed.replace(tzinfo=datetime.timezone.utc)


# What the daemon reports as keeping the Nest busy, in plain words.
BUSY_WORDS = {
    'serving_computers': 'it is serving computers',
    'computers_starting': 'computers are starting or installing from it',
    'building_apps': 'it is building apps',
    'activity_unknown': 'it could not read its own activity',
}


def activity(now, activity=ACTIVITY, uptime=uptime_seconds):
    """Whether the Nest is idle, and why, in plain words. Idle once nothing
    kept the Nest busy for QUIET_SECONDS. A missing or stale report fails
    closed until the Nest has run for a while."""
    try:
        report = load(activity, owner=UID, maximum=4 * 1024)
        if report['schema'] != 'tiaris.nest.activity.v1' or not isinstance(report['busy'], list):
            raise ValueError('unknown activity report')
        age = (now - timestamp(report['written_at'])).total_seconds()
        since = report['idle_since']
        since = None if since is None else timestamp(since)
    except (OSError, ValueError, KeyError, TypeError):
        age, report = None, None
    if report is None or not -60 <= age <= STALE_SECONDS:
        minutes = UNREPORTED_UPTIME_SECONDS // 60
        if uptime() >= UNREPORTED_UPTIME_SECONDS:
            return True, f'its activity report is missing or old, and it has run for more than {minutes} minutes'
        return False, f'its activity report is missing or old, and it started less than {minutes} minutes ago'
    if report['busy']:
        words = sorted({BUSY_WORDS.get(str(reason), str(reason)) for reason in report['busy']})
        return False, ' and '.join(words)
    quiet = None if since is None else (now - since).total_seconds()
    if quiet is None or quiet < QUIET_SECONDS:
        return False, f'it was busy less than {QUIET_SECONDS // 60} minutes ago'
    return True, f'nothing kept it busy for {int(quiet // 60)} minutes'


def idle(now, activity_path=ACTIVITY, uptime=uptime_seconds):
    return activity(now, activity_path, uptime)[0]


def decide(policy, request, now, describe=activity):
    """None when the update may start, else the status stage it waits in;
    and why, in plain words."""
    immediate = policy.get('run_now')
    release = request['release']
    if immediate and (immediate['attempt_id'] == request['attempt_id']
            and immediate['release_id'] == release['release_id']
            and immediate['system_closure_sha256'] == release['system_closure']['sha256']):
        return None, 'someone chose Update now for it'
    is_idle, words = describe(now)
    if is_idle:
        return None, 'the Nest is idle (' + words + ')'
    # The night deadline: a Nest that is never idle updates in the night anyway.
    if in_window(policy['schedule'], now):
        return None, 'it is the night, when the Nest updates even when busy (' + words + ')'
    return 'nest_busy', 'the Nest is busy (' + words + ')'


def waiting_for(policy, request, now, is_idle=idle):
    """None when the update may start, else the status stage it waits in."""
    return decide(policy, request, now, lambda now: (is_idle(now), ''))[0]


def allowed(policy, request, now, is_idle=idle):
    return waiting_for(policy, request, now, is_idle) is None


def main():
    if not (INBOX / 'update-schedule.json').exists() and not (CONTROL / 'update-schedule.json').exists():
        print('nest_busy')
        return 75
    verified = run('/usr/bin/tiaris-nest', 'verify-appliance-update-policy')
    if verified != str(CONTROL / 'update-schedule.json'):
        raise ValueError('invalid verified policy path')
    policy = load(Path(verified), maximum=64 * 1024)
    request = load(INBOX / 'appliance-update-request.json', owner=UID)
    waiting, why = decide(policy, request, datetime.datetime.now(datetime.timezone.utc))
    if waiting is None:
        print(why)
        return 0
    print(waiting)
    print(why)
    return 75


if __name__ == '__main__':
    sys.exit(main())
