#!/usr/bin/env python3
"""Replace the complete appliance default-deny input firewall atomically in one nft transaction."""
import ipaddress
from pathlib import Path
import subprocess
from appliance_state import read


def render(content, existing):
    addresses = [ipaddress.ip_network(line.strip(), strict=True) for line in content.splitlines() if line.strip()]
    if len(addresses) > 128:
        raise ValueError('too many management CIDRs')
    rules = ['delete table inet tiaris_nest'] if existing else []
    rules += [
        'table inet tiaris_nest {',
        'ct helper tftp4 {',
        'type "tftp" protocol udp',
        'l3proto ip',
        '}',
        'chain input {',
        'type filter hook input priority -10; policy drop;',
        'iifname "lo" accept',
        'ct state invalid drop',
        'ct state established,related accept',
        'ip protocol icmp icmp type { echo-request, echo-reply, destination-unreachable, time-exceeded, parameter-problem } accept',
        'ip6 nexthdr icmpv6 icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, echo-request, echo-reply, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept',
        'tcp dport 80 accept',
        'udp dport { 67, 68, 4011 } accept',
        'meta nfproto ipv4 udp dport 69 ct helper set "tftp4" accept',
        'udp dport 123 accept',
        # TURN traffic passes through to inet tiaris_nest_turn (priority -5),
        # which restricts it to private IPv4 sources and the active LAN IP.
        'udp dport { 3478, 61000-61040 } accept',
    ]
    for version, family in ((4, 'ip'), (6, 'ip6')):
        selected = [str(address) for address in addresses if address.version == version]
        if selected:
            rules += [family + ' saddr { ' + ', '.join(selected) + ' } tcp dport 22 accept']
    rules += ['tcp dport 22 drop', '}', '}']
    return '\n'.join(rules) + '\n'


def main():
    content = read(Path('/var/lib/tiaris-nest/control/management-cidrs.txt'), maximum=16384).decode('ascii')
    existing = subprocess.run(['nft', 'list', 'table', 'inet', 'tiaris_nest'], capture_output=True).returncode == 0
    rules = render(content, existing)
    subprocess.run(['nft', '--check', '-f', '-'], input=rules, text=True, check=True)
    subprocess.run(['nft', '-f', '-'], input=rules, text=True, check=True)


if __name__ == '__main__':
    main()
