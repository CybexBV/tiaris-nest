#!/usr/bin/python3
"""Appliance-owned IPv4 PXE proxy supervisor. Never allocates DHCP leases.

Only a complete document Tiaris signed arms discovery. A site has one Nest: it
answers every UEFI computer that starts from the network. Without Tiaris the
Nest keeps serving with the last complete document and reports it as stale;
only a newer complete document changes it and only a withdrawal (Tiaris
removed or replaced this Nest) stops it. The Nest service never replaces a
complete document with an incomplete one.
"""
from __future__ import annotations
import hashlib
import http.client
import ipaddress
import json
import os
from pathlib import Path
import re
import signal
import stat
import subprocess
import sys
import threading
import time
import tomllib

import site_probe

RUN = Path('/run/tiaris-nest-pxe')
CONTROL = Path('/var/lib/tiaris-nest/control')
CONFIG = Path('/etc/tiaris-nest/config.toml')
SCHEMA = 'tiaris.nest.pxe-discovery.v1'
# Older than this, the document is served but reported as stale: Tiaris has
# not been heard from since (the Nest service rewrites it after every sync).
MAX_AGE = 300
INTERVAL = 5
# The site check's boot probe (site_probe.py): every 15 minutes, and when the
# Nest service asks (`site-check-request.json`), at most every 30 seconds.
PROBE_INTERVAL = 900
PROBE_MIN_INTERVAL = 30
STOP = False

class Unavailable(Exception):
    pass

def require(condition, reason):
    if not condition:
        raise Unavailable(reason)

def bounded(path, limit=2 * 1024 * 1024, *, root=False):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, 'rb') as stream:
        info = os.fstat(stream.fileno())
        require(stat.S_ISREG(info.st_mode) and info.st_nlink == 1, 'unsafe_state_file')
        if root:
            require(info.st_uid == 0 and not info.st_mode & 0o022, 'unsafe_configuration')
        value = stream.read(limit + 1)
    require(len(value) <= limit, 'inventory_too_large')
    return value

def read_json(path, **kwargs):
    return json.loads(bounded(path, **kwargs))

def run(args):
    result = subprocess.run(args, capture_output=True, timeout=4, check=False)
    require(result.returncode == 0 and len(result.stdout) <= 2 * 1024 * 1024, 'network_probe_failed')
    return result.stdout

def atomic(path, value):
    data = (json.dumps(value, separators=(',', ':')) + '\n').encode()
    temporary = path.with_suffix('.new')
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o644)
    with os.fdopen(fd, 'wb') as stream:
        stream.write(data)
    os.replace(temporary, path)

def mac(value):
    require(isinstance(value, str) and re.fullmatch(r'[0-9a-f]{2}(?::[0-9a-f]{2}){5}', value), 'invalid_mac')
    require(int(value[:2], 16) & 1 == 0 and value != '00:00:00:00:00:00', 'invalid_mac')
    return value

def identity(value):
    require(isinstance(value, str) and re.fullmatch(r'[A-Za-z0-9_-]{1,128}', value), 'invalid_identity')
    return value

def address(value):
    ip = ipaddress.IPv4Address(value)
    require(not (ip.is_loopback or ip.is_unspecified or ip.is_multicast or ip.is_link_local or str(ip) == '255.255.255.255'), 'invalid_address')
    return ip

def network_from(plan, interfaces, actual_mac):
    network = plan.get('network', {})
    require(network.get('version') == 2 and network.get('renderer') == 'networkd', 'network_plan_invalid')
    devices = network.get('ethernets', {})
    require(list(devices) == ['tiaris-nest'], 'network_plan_invalid')
    nic = devices['tiaris-nest']
    name = nic.get('set-name', '')
    require(re.fullmatch(r'[A-Za-z0-9_.-]{1,15}', name) and name != 'lo', 'network_plan_invalid')
    expected_mac = mac(nic.get('match', {}).get('macaddress', '').lower())
    require(expected_mac == actual_mac, 'interface_identity_changed')
    require(len(interfaces) == 1 and interfaces[0].get('ifname') == name, 'interface_unavailable')
    require('UP' in interfaces[0].get('flags', []) and 'LOWER_UP' in interfaces[0].get('flags', []), 'interface_unavailable')
    candidates = []
    for item in interfaces[0].get('addr_info', []):
        if item.get('family') != 'inet' or item.get('scope') != 'global' or item.get('preferred_life_time') == 0:
            continue
        if set(item.get('flags', [])) & {'secondary', 'tentative', 'dadfailed', 'deprecated'}:
            continue
        ip = address(item['local'])
        prefix = item.get('prefixlen')
        require(isinstance(prefix, int) and 1 <= prefix <= 30, 'subnet_unsupported')
        candidates.append(ipaddress.IPv4Interface(f'{ip}/{prefix}'))
    if nic.get('dhcp4') is True:
        require(not nic.get('addresses') and len(candidates) == 1, 'address_ambiguous')
        selected = candidates[0]
    else:
        require(len(nic.get('addresses', [])) == 1, 'network_plan_invalid')
        selected = ipaddress.IPv4Interface(nic['addresses'][0])
        require(selected in candidates, 'approved_address_unavailable')
    require(selected.ip not in (selected.network.network_address, selected.network.broadcast_address), 'invalid_address')
    return {'interface': name, 'mac': expected_mac, 'address': str(selected.ip), 'cidr': str(selected.network)}

def current_network():
    effective = Path('/run/tiaris-nest-network/netplan-approved.json')
    raw = bounded(effective if effective.exists() else CONTROL / 'netplan-approved.json', root=True)
    marker = CONTROL / 'network-fallback-active'
    if marker.exists():
        fallback = read_json(marker, limit=256, root=True)
        require(fallback.get('schema') == 'tiaris.nest.network-fallback.v1', 'network_plan_invalid')
        digest = fallback.get('approved_sha256', '')
        require(re.fullmatch('[0-9a-f]{64}', digest), 'network_plan_invalid')
        if digest == hashlib.sha256(raw).hexdigest():
            raw = bounded(CONTROL / 'netplan-dhcp-fallback.json', root=True)
    plan = json.loads(raw)
    name = plan.get('network', {}).get('ethernets', {}).get('tiaris-nest', {}).get('set-name', '')
    require(re.fullmatch(r'[A-Za-z0-9_.-]{1,15}', name), 'network_plan_invalid')
    actual_mac = Path('/sys/class/net', name, 'address').read_text().strip().lower()
    interfaces = json.loads(run(['/usr/sbin/ip', '-j', '-4', 'address', 'show', 'dev', name]))
    return network_from(plan, interfaces, actual_mac)

def validate_desired(wrapper, now):
    """The document's identity and boot file; whether it is stale. Age alone
    never refuses it: a school without internet keeps starting computers."""
    received = wrapper.get('received_at')
    require(type(received) is int, 'inventory_unavailable')
    desired = wrapper.get('desired')
    require(isinstance(desired, dict) and desired.get('schema') == SCHEMA, 'inventory_unavailable')
    require(desired.get('complete') is True, 'inventory_incomplete')
    own = identity(desired.get('server_device_id'))
    filename = wrapper.get('bootloader_filename')
    if filename is None:
        # A Nest up to 0.2.177 wrote this file: it kept the boot file only in
        # its own row of `peers`. A Nest that updates from one serves at once
        # with it, also before it reaches Tiaris.
        peers = desired.get('peers')
        rows = [peer for peer in peers if isinstance(peer, dict) and peer.get('server_device_id') == own] if isinstance(peers, list) else []
        require(rows, 'awaiting_appliance_report')
        filename = rows[0].get('bootloader_filename')
    require(filename in ('snponly.efi', 'ipxe.efi'), 'inventory_unavailable')
    return desired, filename, not 0 <= now - received <= MAX_AGE

def http_json(ip, source):
    connection = http.client.HTTPConnection(ip, 80, timeout=2, source_address=(source, 0))
    try:
        connection.request('GET', '/healthz/pxe', headers={'Connection':'close'})
        response = connection.getresponse()
        require(response.status == 200, 'boot_service_unavailable')
        body = response.read(1025)
        require(len(body) <= 1024, 'boot_service_unavailable')
        result = json.loads(body)
        require(result.get('schema') == 'tiaris.nest.pxe-candidate.v1', 'boot_service_unavailable')
        return result
    finally:
        connection.close()

def dnsmasq_config(network, filename):
    subnet = ipaddress.IPv4Network(network['cidr'])
    lines = ['# Generated by Tiaris Nest; no address allocation or DNS service.',
             'port=0', 'leasefile-ro', 'bind-interfaces', f"interface={network['interface']}", 'except-interface=lo',
             'user=dnsmasq', 'group=nogroup', 'pid-file=', 'log-facility=-', 'log-dhcp',
             'dhcp-no-override', f'dhcp-range={subnet.network_address},proxy,{subnet.netmask}',
             'dhcp-match=set:uefi64,option:client-arch,7',
             'dhcp-match=set:uefi64,option:client-arch,9',
             'dhcp-ignore=tag:!uefi64']
    ip = network['address']
    for arch in (7, 9):
        lines.append(f'pxe-service={arch},"Tiaris Nest",{filename},{ip}')
    lines.append(f'dhcp-boot={filename},,{ip}')
    return '\n'.join(lines) + '\n'

class Supervisor:
    def __init__(self):
        self.process = None
        self.config = None
        self.last_reason = None
        self.identity = None
        self.retry_after = 0.0
        self.monitor = site_probe.AnswerMonitor()
        self.probed_at = 0.0
        self.probe_request = None

    def follow(self, stream):
        # Proxy answers feed the dropped-answer monitor; everything except
        # log-dhcp's per-option detail still reaches the journal.
        for raw in stream:
            line = raw.decode('utf-8', 'replace').rstrip('\n')
            try:
                self.monitor.feed(line)
            except Exception:
                pass
            if not site_probe.TYPE_LINE.search(line) and not re.search(r'\d+ (?:sent size|available DHCP|vendor class|tags|next server|broadcast response|user class|client provides)', line):
                print(line, flush=True)

    def maybe_probe(self, network, own, state_dir):
        # Evidence only: a failing probe never touches the boot service.
        try:
            request = None
            path = state_dir / 'site-check-request.json'
            if path.exists():
                try:
                    request = site_probe.requested_at(read_json(path, limit=1024))
                except (Unavailable, OSError, ValueError):
                    request = None
            now = time.monotonic()
            requested = request is not None and request != self.probe_request
            due = not self.probed_at or now - self.probed_at >= PROBE_INTERVAL
            if not due and not (requested and now - self.probed_at >= PROBE_MIN_INTERVAL):
                return
            self.monitor.ignore = {site_probe.probe_mac(own)}
            result = site_probe.probe(network['interface'], network['address'], own)
            result.update(self.monitor.summary())
            atomic(RUN / 'boot-probe.json', site_probe.stamp(result))
            self.probed_at = time.monotonic()
            if request is not None:
                self.probe_request = request
        except Exception as error:
            try:
                atomic(RUN / 'boot-probe.json', site_probe.stamp({'outcome': 'error', 'error': 'probe_failed'}))
            except OSError:
                pass
            print(f'PXE discovery: boot probe failed ({type(error).__name__})', flush=True)
            self.probed_at = time.monotonic()

    def stop(self):
        if self.process is not None:
            self.process.terminate()
            try: self.process.wait(timeout=3)
            except subprocess.TimeoutExpired:
                self.process.kill(); self.process.wait(timeout=3)
        self.process = None
        self.config = None

    def status(self, state, reason, eligible=False):
        atomic(RUN / 'status.json', {'schema':'tiaris.nest.pxe-status.v1', 'checked_at':int(time.time()),
               'status':state, 'reason':reason, 'eligible':eligible, 'identity':self.identity})
        if self.last_reason != (state, reason):
            print(f'PXE discovery: {state} ({reason})', flush=True)
            self.last_reason = (state, reason)

    def failed(self, error):
        self.stop()
        reason = str(error) if isinstance(error, Unavailable) else 'supervisor_error'
        if reason in ('proxy_process_failed', 'proxy_configuration_invalid'):
            self.retry_after = time.monotonic() + 30
        self.status('unavailable', reason)

    def reconcile(self):
        if time.monotonic() < self.retry_after:
            self.status('unavailable', 'proxy_retry_pending'); return
        config = tomllib.loads(bounded(CONFIG, root=True).decode())
        state_path = Path(config['manage']['state_path'])
        require(str(state_path.parent) in ('/var/lib/tiaris-nest/state/agent', '/var/lib/tiaris-nest/state'), 'unsafe_state_path')
        desired, filename, stale = validate_desired(read_json(state_path.parent / 'pxe-discovery.json'), int(time.time()))
        network = current_network()
        own = desired['server_device_id']
        self.identity = hashlib.sha256(own.encode()).hexdigest()
        # Readiness checks only the boot path, never this supervisor (no cycle).
        require(http_json(network['address'], network['address']).get('ready') is True, 'boot_service_unavailable')
        text = dnsmasq_config(network, filename)
        if self.process is not None and self.process.poll() is not None:
            self.stop()
            raise Unavailable('proxy_process_failed')
        if text != self.config:
            self.stop()
            path = RUN / 'dnsmasq.conf'
            path.write_text(text)
            # Parse before binding any network socket; no shell or user options.
            result = subprocess.run(['/usr/sbin/dnsmasq', '--test', f'--conf-file={path}'], capture_output=True, timeout=4)
            require(result.returncode == 0, 'proxy_configuration_invalid')
            self.process = subprocess.Popen(['/usr/sbin/dnsmasq', '--keep-in-foreground', f'--conf-file={path}'], stderr=subprocess.PIPE)
            threading.Thread(target=self.follow, args=(self.process.stderr,), daemon=True).start()
            time.sleep(0.1)
            require(self.process.poll() is None, 'proxy_process_failed')
            self.config = text
        self.status('active', 'inventory_stale' if stale else 'proxy_ready', True)
        self.maybe_probe(network, own, state_path.parent)

def main():
    global STOP
    require(os.geteuid() == 0, 'root_required')
    RUN.mkdir(mode=0o755, parents=True, exist_ok=True)
    require(RUN.stat().st_uid == 0 and not RUN.is_symlink(), 'unsafe_state_path')
    supervisor = Supervisor()
    def stop_signal(signum, frame):
        global STOP
        STOP = True
    signal.signal(signal.SIGTERM, stop_signal)
    signal.signal(signal.SIGINT, stop_signal)
    try:
        while not STOP:
            try:
                supervisor.reconcile()
            except Exception as error:
                supervisor.failed(error)
            deadline = time.monotonic() + INTERVAL
            while not STOP and time.monotonic() < deadline:
                time.sleep(0.2)
    finally:
        supervisor.stop()
        supervisor.status('unavailable', 'supervisor_stopped')

if __name__ == '__main__':
    main()
