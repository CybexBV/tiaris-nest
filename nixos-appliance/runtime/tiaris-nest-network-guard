#!/usr/bin/env bash
# Chooses the Nest's network profile once per start. Reaching Tiaris is a
# fact the Nest reports, never a condition to start: after a power cut the
# school's internet comes back last, and the Nest must serve from what it has.
#
# - Tiaris answers on the approved profile: keep it.
# - A fixed address that cannot reach Tiaris while DHCP can: the address is
#   wrong for this network, so the DHCP fallback stays active (with its marker).
# - Tiaris answers on neither: the internet is down, and this start cannot
#   tell which address works. The Nest starts on the profile it last reached
#   Tiaris with: the DHCP fallback when its marker for this approved profile
#   is still there (the marker stays), the approved profile otherwise. Nothing
#   probes again until the next start, so a Nest that served the school on
#   DHCP must not go back to a fixed address that never worked here.
set -Eeuo pipefail
umask 077

control_dir=/var/lib/tiaris-nest/control
approved="$control_dir/netplan-approved.json"
if [[ -s /run/tiaris-nest-network/netplan-approved.json ]]; then
  approved=/run/tiaris-nest-network/netplan-approved.json
fi
fallback="$control_dir/netplan-dhcp-fallback.json"
active=/etc/netplan/90-tiaris-nest.yaml
plan="$control_dir/install-plan.json"
test -s "$approved" && test -s "$fallback" && test -s "$plan"

install -m 0600 "$approved" "$active"
/usr/lib/tiaris-nest/tiaris-nest-netplan-activate
stored_origin="$(jq -er '.manage_origin' "$control_dir/provisioning-state.json")"
# The build's own origin for its own or its one legacy name (a Nest installed
# for manage.cybex.net reaches manage.tiaris.com); any other origin is refused
# (the start-up checks refuse it too: validate-installed-state).
origin="$(/usr/lib/tiaris-nest/tiaris-nest-bootstrap effective-manage-origin "$stored_origin")"
test -n "$origin"

# Activation makes networkd reconfigure the link even for an unchanged profile:
# the DHCP lease, route and resolver are briefly dropped and re-acquired, so a
# single immediate request can fail during that reset. Retry until the bounded
# deadline, which keeps the budget the single request previously had.
management_reachable() {
  local deadline=$((SECONDS + $1)) remaining
  while remaining=$((deadline - SECONDS)); ((remaining > 0)); do
    if timeout "$remaining" curl --fail --silent --show-error --proto '=https' --tlsv1.2 \
      --connect-timeout 10 --output /dev/null "$origin/healthz"; then
      return 0
    fi
    sleep 1
  done
  return 1
}

approved_sha256="$(sha256sum "$approved" | awk '{print $1}')"
[[ "$approved_sha256" =~ ^[0-9a-f]{64}$ ]]

# The marker selects the DHCP profile for the periodic network task, the boot
# service and the Nest's report. Written new each time, so its readers always
# find a root-owned 0600 file.
write_fallback_marker() {
  local marker
  marker="$(mktemp "$control_dir/.network-fallback-active.XXXXXX")"
  jq -n --arg approved_sha256 "$approved_sha256" \
    '{schema:"tiaris.nest.network-fallback.v1",approved_sha256:$approved_sha256}' \
    > "$marker"
  chmod 0600 "$marker"
  chown root:root "$marker"
  sync -f "$marker"
  mv -f "$marker" "$control_dir/network-fallback-active"
  sync -f "$control_dir"
}

# An earlier start reached Tiaris on DHCP and not on this approved profile.
fallback_marker_current() {
  local marker="$control_dir/network-fallback-active"
  [[ -f "$marker" && ! -L "$marker" ]] || return 1
  jq -e --arg approved_sha256 "$approved_sha256" \
    '.schema == "tiaris.nest.network-fallback.v1" and .approved_sha256 == $approved_sha256' \
    "$marker" >/dev/null 2>&1
}

if management_reachable 30; then
  # The approved profile reaches Tiaris again: DHCP recovery is over.
  rm -f "$control_dir/network-fallback-active"
  sync -f "$control_dir"
  exit 0
fi

dhcp4="$(jq -r '.network.ethernets["tiaris-nest"].dhcp4 | if type == "boolean" then tostring else error("invalid approved DHCP mode") end' "$approved")"
if [[ "$dhcp4" != false ]]; then
  # DHCP has no other profile to try. The approved profile stays.
  rm -f "$control_dir/network-fallback-active"
  sync -f "$control_dir"
  echo "Tiaris does not answer; the Nest starts on its approved network" >&2
  exit 0
fi

install -m 0600 "$fallback" "$active"
/usr/lib/tiaris-nest/tiaris-nest-netplan-activate
if management_reachable 60; then
  # DHCP is now the verified active recovery profile; keep its selector.
  write_fallback_marker
  echo "the fixed address does not reach Tiaris and DHCP does; the Nest starts on DHCP" >&2
  exit 0
fi

if fallback_marker_current; then
  # Neither profile reaches Tiaris, and DHCP is the one that last did: it is
  # already active, and it stays, with its marker.
  write_fallback_marker
  echo "Tiaris does not answer on the fixed address or on DHCP; the Nest starts on DHCP, which reached Tiaris last" >&2
  exit 0
fi

# Neither profile reaches Tiaris and DHCP never did: start on the approved one.
install -m 0600 "$approved" "$active"
/usr/lib/tiaris-nest/tiaris-nest-netplan-activate
rm -f "$control_dir/network-fallback-active"
sync -f "$control_dir"
echo "Tiaris does not answer on the fixed address or on DHCP; the Nest starts on its approved network" >&2
